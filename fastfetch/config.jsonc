{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/arch/rising.txt",
    "color": {
      "1": "#3584e4",
      "2": "#1b467c",
      "3": "yellow",
      "4": "magenta",
      "5": "green",
      "6": "red",
      "7": "white",
      "8": "black",
      "9": "default"
    },
    "padding": {
      "top": 1,
      "right": 6,
      "bottom": 1
    }
  },
  "display": {
    "separator": "     ",
    "color": {
      "keys": "#3584e4",
      "title": "#1b467c"
    },
    "percent": {
      "color": {
        "green": "#ffffff",
        "yellow": "#8fbbf0",
        "red": "#c01c28"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#32}{1}{#90} @ {#34}aeofetch"
    },
    "break",
    {
      "type": "os",
      "key": "{#34}󱄅  os    ",
      "format": "NixOS"
    },
    {
      "type": "wm",
      "key": "{#35}  wm    ",
      "format": "Umbriel"
    },
    {
      "type": "shell",
      "key": "{#32}  shell ",
      "format": "{exe-name}"
    },
    {
      "type": "uptime",
      "key": "{#33}󰅐  uptime",
      "format": "{hours}h {minutes}m"
    },
    {
      "type": "cpu",
      "key": "{#31}  cpu   ",
      "format": "{name}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#33}󰮯   {#32}󰊠 {#31}󰊠 {#33}󰊠 {#35}󰊠 {#36}󰊠 {#90}󰊠 {#34}󰊠 {#93}󰊠 {#37}󰊠  "
    },
    "break"
  ]
}
