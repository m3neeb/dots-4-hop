{ pkgs, ... }:

let
  adw = "${pkgs.adw-gtk3}/share/themes/adw-gtk3-dark/gtk-4.0";
in
{
  # noctalia.css and noctalia-extensions.css are generated by Noctalia, so they
  # are not linked: the gtk-*.0 directories stay real, writable directories and
  # only the files below are symlinks. gtk.css just @imports noctalia.css.
  xdg.configFile = {
    "gtk-3.0/settings.ini".source = ./config/gtk-3.0/settings.ini;
    "gtk-3.0/gtk.css".source = ./config/gtk-3.0/gtk.css;
    "gtk-3.0/bookmarks".source = ./config/gtk-3.0/bookmarks;

    "gtk-4.0/settings.ini".source = ./config/gtk-4.0/settings.ini;
    "gtk-4.0/gtk.css".source = ./config/gtk-4.0/gtk.css;
    "gtk-4.0/borders.css".source = ./config/gtk-4.0/borders.css;
    # force: these used to be symlinks into /run/current-system, which
    # home-manager would otherwise refuse to replace.
    "gtk-4.0/gtk-dark.css" = {
      source = "${adw}/gtk-dark.css";
      force = true;
    };
    "gtk-4.0/assets" = {
      source = "${adw}/assets";
      force = true;
    };
  };
}
